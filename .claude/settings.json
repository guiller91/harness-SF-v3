{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrator",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "SF_AUTOUPDATE_DISABLE": "true"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(./hx *)",
      "Bash(sf project deploy *)",
      "Bash(sf project retrieve *)",
      "Bash(sf project generate *)",
      "Bash(sf apex run test *)",
      "Bash(sf apex get *)",
      "Bash(sf data query *)",
      "Bash(sf sobject *)",
      "Bash(sf org list *)",
      "Bash(sf code-analyzer *)",
      "Bash(sf agent validate *)",
      "Bash(sf agent generate *)",
      "Bash(sf agent test *)",
      "Bash(npx sfdx-lwc-jest *)",
      "Bash(npm run test:unit *)",
      "Bash(npx prettier *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git show *)",
      "Bash(sf project *)",
      "Bash(sf apex *)",
      "Bash(sf lightning *)",
      "Bash(sf flow *)"
    ],
    "ask": [
      "Bash(./hx approve *)",
      "Bash(./hx close *)",
      "Bash(git push *)",
      "Bash(sf org delete *)",
      "Bash(sf data delete *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.sf/**)",
      "Read(~/.sfdx/**)",
      "Bash(sf org login *)",
      "Bash(sf org display *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run\" session_context.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run\" guard_bash.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run\" guard_write.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run\" post_edit_checks.py",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run\" subagent_start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run\" subagent_stop.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run\" stop_guard.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
